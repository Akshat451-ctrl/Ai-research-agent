# ---- Secrets: NEVER commit these ----
.env
.env.*
!.env.example

# ---- Python virtual environment ----
.venv/
venv/
env/

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Generated data (rebuildable, often large) ----
data/vector_db/*
!data/vector_db/.gitkeep

# ---- Editor / OS noise ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
